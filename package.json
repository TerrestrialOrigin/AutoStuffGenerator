{
  "name": "auto-stuff-generator-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "npm-workspaces monorepo root for auto-stuff-generator and its generator packages",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "type-check": "npm run type-check --workspaces --if-present"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TerrestrialOrigin/AutoStuffGenerator.git"
  },
  "author": "Terrestrial Origin LLC",
  "license": "MIT"
}

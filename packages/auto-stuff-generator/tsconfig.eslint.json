{
  // Lint-only project: gives typescript-eslint full type information for EVERY
  // linted file — including the *.spec.ts and scripts/ files that the build
  // tsconfig deliberately excludes from emit. Never used to emit output.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
